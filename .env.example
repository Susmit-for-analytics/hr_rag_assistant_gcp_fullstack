# ---- GCP ----
PROJECT_ID=your-gcp-project-id
LOCATION=us-central1
REGION=us-central1
GCS_BUCKET_NAME=your-bucket-name

# ---- Vector store (Qdrant Cloud) ----
QDRANT_URL=https://xxxx.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=hr_policies
QDRANT_NOISY_COLLECTION_NAME=hr_policies_noisy_demo

# ---- Embeddings + reranker (Jina AI) ----
JINA_API_KEY=

# ---- Safety guardrail (Model Armor) ----
GUARDRAIL_PROVIDER=model_armor
MODEL_ARMOR_LOCATION=us
MODEL_ARMOR_TEMPLATE_ID=hr-assistant-guardrail

# ---- Fallback model + eval judge (Groq) ----
GROQ_API_KEY=

# ---- Tracing + evaluation (LangSmith) ----
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hr-policy-assistant

# ---- Access control (deployed app only) ----
ALLOWED_EMPLOYEE_EMAILS=someone@example.com,someone.else@example.com
